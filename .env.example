# --- Supabase (required) ---------------------------------------------------
# Project settings → API. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of your deployment, used for Stripe redirects (optional on Vercel).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Card payments with Stripe (optional) ----------------------------------
# Without these, stores take manual payments (bank transfer / cash on delivery).
# Both STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are needed to enable cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
